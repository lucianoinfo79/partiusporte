<%# Shared event card: Home and Catalog use the same Atlas public event projection. %>
<% identifier = event[:slug].presence || event[:id].presence %>
<% detail_url = public_event_path(identifier) if identifier.present? %>
<% cover_url = event[:image_url].to_s %>
<% safe_cover = cover_url.start_with?("https://", "http://") %>
<article class="pp-catalog-card pp-unified-event-card">
  <div class="pp-catalog-card__media">
    <% if safe_cover %>
      <%= image_tag cover_url, alt: "", loading: "lazy" %>
    <% else %>
      <span class="pp-catalog-card__placeholder" aria-hidden="true">partiusporte</span>
    <% end %>
    <% if event[:starts_at].present? %>
      <span class="pp-catalog-card__date"><%= l(event[:starts_at].to_date, format: "%d/%m/%Y") %></span>
    <% end %>
  </div>
  <div class="pp-catalog-card__content">
    <span class="pp-badge"><%= event[:modality].presence || "Evento esportivo" %></span>
    <h3>
      <% if detail_url %>
        <%= link_to event[:name], detail_url, class: "pp-unified-event-card__title-link" %>
      <% else %>
        <%= event[:name] %>
      <% end %>
    </h3>
    <p><%= [event[:city], event[:state]].compact_blank.join(" · ").presence || "Local a confirmar" %></p>
    <% if event[:registration_status].present? %>
      <span class="pp-badge pp-badge--success"><%= event[:registration_status].to_s.humanize %></span>
    <% end %>
    <% if detail_url %>
      <%= link_to "Ver detalhes", detail_url, class: "pp-catalog-card__detail", aria: { label: "Ver detalhes de #{event[:name]}" } %>
    <% end %>
  </div>
</article>
