<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title><%= pp_seo_title %></title>
    <meta name="description" content="<%= pp_seo_description %>">
    <meta name="robots" content="<%= pp_seo_noindex? ? "noindex,follow" : "index,follow" %>">
    <% if pp_seo_canonical.present? %><link rel="canonical" href="<%= pp_seo_canonical %>"><% end %>
    <meta property="og:type" content="<%= content_for(:seo_type).presence || "website" %>">
    <meta property="og:site_name" content="partiusporte">
    <meta property="og:locale" content="pt_BR">
    <meta property="og:title" content="<%= pp_seo_title %>">
    <meta property="og:description" content="<%= pp_seo_description %>">
    <% if pp_seo_canonical.present? %><meta property="og:url" content="<%= pp_seo_canonical %>"><% end %>
    <% if pp_seo_image.present? %><meta property="og:image" content="<%= pp_seo_image %>"><% end %>
    <meta name="twitter:card" content="<%= pp_seo_image.present? ? "summary_large_image" : "summary" %>">
    <meta name="twitter:title" content="<%= pp_seo_title %>">
    <meta name="twitter:description" content="<%= pp_seo_description %>">
    <% if pp_seo_json_ld.present? %><script type="application/ld+json"><%= raw(json_escape(pp_seo_json_ld.to_s)) %></script><% end %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#16a34a">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "pp02_4", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "pp02_4_6", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "pp02_5", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "pp02_6", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "pp02_7", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "pp02_8", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "pp02_9", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "pp02_10", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="pp-body">
    <a class="pp-skip-link" href="#conteudo">Ir para o conteúdo</a>

    <header class="pp-header" data-public-shell="header">
      <div class="pp-container pp-header__inner">
        <%= link_to root_path, class: "pp-brand", aria: { label: "partiusporte — início" } do %>
          <%= image_tag "partiusporte/partiusporte-logo.png", alt: "partiusporte", class: "pp-brand__official-logo" %>
        <% end %>

        <nav class="pp-nav pp-nav--desktop" aria-label="Navegação principal">
          <%= link_to "Eventos", public_events_path, class: "pp-nav__link" %>
          <%= link_to "Calendário", public_calendar_path, class: "pp-nav__link", aria: { current: (controller_name == "calendar" ? "page" : nil) } %>
          <%= link_to "Resultados", public_results_path, class: "pp-nav__link" %>
          <%= link_to "Fotos", public_photos_path, class: "pp-nav__link" %>
          <%= link_to "Sobre", "#sobre", class: "pp-nav__link" %>
          <%= link_to "Contato", "#contato", class: "pp-nav__link" %>
        </nav>

        <div class="pp-header__actions">
          <button class="pp-icon-button pp-search-trigger" type="button" aria-label="Buscar">⌕</button>
          <a class="pp-link-button pp-auth-action" href="#entrar">Entrar</a>
          <a class="pp-button pp-button--primary pp-auth-action" href="#criar-conta">Criar conta</a>
          <button class="pp-menu-button" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="pp-mobile-menu">☰</button>
        </div>
      </div>

      <nav id="pp-mobile-menu" class="pp-mobile-menu" aria-label="Navegação móvel">
        <div class="pp-container pp-mobile-menu__inner">
          <%= link_to "Eventos", public_events_path %>
          <%= link_to "Calendário", public_calendar_path %>
          <%= link_to "Resultados", public_results_path %>
          <%= link_to "Fotos", public_photos_path %>
          <%= link_to "Sobre", "#sobre" %>
          <%= link_to "Contato", "#contato" %>
        </div>
      </nav>
    </header>

    <main id="conteudo" class="pp-main">
      <%= yield %>
    </main>

    <footer class="pp-footer" id="contato">
      <div class="pp-container pp-footer__grid">
        <div>
          <div class="pp-brand pp-brand--footer"><%= image_tag "partiusporte/partiusporte-logo.png", alt: "partiusporte", class: "pp-brand__official-logo" %></div>
          <p>Encontre provas, acompanhe resultados e reviva seus melhores momentos.</p>
        </div>
        <div class="pp-footer__links">
          <%= link_to "Eventos", public_events_path %><%= link_to "Resultados", public_results_path %><%= link_to "Fotos", public_photos_path %>
          <a href="#sobre">Sobre</a><a href="#contato">Contato</a>
        </div>
      </div>
      <div class="pp-container pp-footer__bottom">
        <span class="pp-footer__copyright">© <%= Time.current.year %> partiusporte</span>
        <div class="pp-footer__credits" aria-label="Desenvolvido por MGL Sports com ATLAS">
          <span class="pp-footer__credits-label">Desenvolvido por MGL Sports</span>
          <%= image_tag "brands/MGL-oficial-somente-MGL-transparente-2400px.png", alt: "MGL Sports", class: "pp-footer__logo pp-footer__logo--mgl" %>
          <span class="pp-footer__logo-frame pp-footer__logo-frame--atlas">
            <%= image_tag "brands/atlas-logo-horizontal-sem-expansao-transparente.png", alt: "ATLAS", class: "pp-footer__logo pp-footer__logo--atlas" %>
          </span>
        </div>
      </div>
    </footer>

    <script>
      document.addEventListener("turbo:load", () => {
        const button = document.querySelector(".pp-menu-button");
        const menu = document.querySelector("#pp-mobile-menu");
        if (!button || !menu || button.dataset.bound === "true") return;
        button.dataset.bound = "true";
        button.addEventListener("click", () => {
          const open = menu.classList.toggle("is-open");
          button.setAttribute("aria-expanded", open ? "true" : "false");
          button.textContent = open ? "×" : "☰";
        });
      });
    </script>
    <script>
      document.addEventListener("turbo:load", () => {
        document.querySelectorAll("[data-pp-event-carousel]").forEach((carousel) => {
          if (carousel.dataset.carouselBound === "true") return;
          carousel.dataset.carouselBound = "true";

          const track = carousel.querySelector("[data-pp-carousel-track]");
          const cards = Array.from(carousel.querySelectorAll("[data-pp-carousel-card]"));
          const previous = carousel.querySelector('[data-pp-carousel-dir="-1"]');
          const next = carousel.querySelector('[data-pp-carousel-dir="1"]');
          const toggle = carousel.querySelector("[data-pp-carousel-toggle]");
          const dotsContainer = carousel.querySelector("[data-pp-carousel-dots]");
          if (!track || cards.length === 0) return;

          let autoAdvanceTimer = null;
          let manuallyPaused = false;
          const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          const stopAutoAdvance = () => {
            window.clearTimeout(autoAdvanceTimer);
            autoAdvanceTimer = null;
          };
          const canAutoAdvance = () => cards.length > 1 &&
            track.scrollWidth > track.clientWidth + 1 &&
            !document.hidden &&
            !reducedMotion &&
            !manuallyPaused &&
            !carousel.matches(":hover") &&
            (!carousel.contains(document.activeElement) || document.activeElement === toggle);
          const scheduleAutoAdvance = () => {
            stopAutoAdvance();
            if (!canAutoAdvance()) return;

            autoAdvanceTimer = window.setTimeout(() => {
              const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
              const nextPosition = track.scrollLeft >= maxScroll - 1
                ? 0
                : Math.min(track.scrollLeft + track.clientWidth, maxScroll);
              track.scrollTo({ left: nextPosition, behavior: "smooth" });
              scheduleAutoAdvance();
            }, 5000);
          };

          const pageCount = () => {
            const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
            return maxScroll <= 1 ? 1 : Math.ceil(maxScroll / track.clientWidth) + 1;
          };

          const update = () => {
            const maxScroll = Math.max(0, track.scrollWidth - track.clientWidth);
            if (previous) previous.disabled = track.scrollLeft <= 1;
            if (next) next.disabled = track.scrollLeft >= maxScroll - 1;

            const pages = pageCount();
            if (toggle) {
              toggle.hidden = pages <= 1 || reducedMotion;
              toggle.setAttribute("aria-pressed", manuallyPaused ? "true" : "false");
              toggle.setAttribute("aria-label", manuallyPaused ? "Retomar rotação automática" : "Pausar rotação automática");
              toggle.textContent = manuallyPaused ? "▶" : "Ⅱ";
            }
            if (dotsContainer) {
              dotsContainer.hidden = pages <= 1;
              if (dotsContainer.children.length !== pages) {
                dotsContainer.replaceChildren(...Array.from({ length: pages }, (_, index) => {
                  const dot = document.createElement("button");
                  dot.type = "button";
                  dot.className = "pp-active-events__dot";
                  dot.setAttribute("aria-label", `Mostrar grupo ${index + 1} de eventos ativos`);
                  dot.addEventListener("click", () => {
                    const currentMax = Math.max(0, track.scrollWidth - track.clientWidth);
                    const currentPages = pageCount();
                    const target = currentPages <= 1 ? 0 : currentMax * index / (currentPages - 1);
                    track.scrollTo({ left: target, behavior: reducedMotion ? "auto" : "smooth" });
                  });
                  return dot;
                }));
              }

              const currentIndex = pages <= 1 ? 0 : Math.round(track.scrollLeft / maxScroll * (pages - 1));
              Array.from(dotsContainer.children).forEach((dot, index) => {
                const active = index === currentIndex;
              dot.classList.toggle("is-active", active);
              dot.setAttribute("aria-current", active ? "true" : "false");
            });
            }
          };

          previous?.addEventListener("click", () => {
            stopAutoAdvance();
            track.scrollBy({ left: -track.clientWidth, behavior: reducedMotion ? "auto" : "smooth" });
            scheduleAutoAdvance();
          });
          next?.addEventListener("click", () => {
            stopAutoAdvance();
            track.scrollBy({ left: track.clientWidth, behavior: reducedMotion ? "auto" : "smooth" });
            scheduleAutoAdvance();
          });
          toggle?.addEventListener("click", () => {
            manuallyPaused = !manuallyPaused;
            update();
            if (manuallyPaused) stopAutoAdvance();
            else scheduleAutoAdvance();
          });
          carousel.addEventListener("mouseenter", stopAutoAdvance);
          carousel.addEventListener("mouseleave", scheduleAutoAdvance);
          carousel.addEventListener("focusin", stopAutoAdvance);
          carousel.addEventListener("focusout", (event) => {
            if (!carousel.contains(event.relatedTarget)) scheduleAutoAdvance();
          });
          carousel.addEventListener("pointerdown", stopAutoAdvance);
          carousel.addEventListener("pointerup", scheduleAutoAdvance);
          carousel.addEventListener("pointercancel", scheduleAutoAdvance);
          document.addEventListener("visibilitychange", () => {
            if (document.hidden) stopAutoAdvance();
            else scheduleAutoAdvance();
          });
          track.addEventListener("scroll", () => window.requestAnimationFrame(update), { passive: true });
          window.addEventListener("resize", update, { passive: true });
          update();
          scheduleAutoAdvance();
        });
      });
    </script>
  </body>
</html>
